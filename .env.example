# ==============================================================================
# MULTI-AGENT RESEARCH & REPORT CREW - CONFIGURATION FILE (.env)
# ==============================================================================
# Urdu: Iss file mein saari API keys aur setup variables rakhe jatay hain.
# English: This file stores all your API keys and configuration variables.

# ------------------------------------------------------------------------------
# 1. GEMINI_API_KEY (REQUIRED / LAZMI)
# ------------------------------------------------------------------------------
# Urdu: Google Gemini API key. Yeh CrewAI agents ke AI models ko chalanay ke liye lazmi hai.
# English: Google Gemini API Key required for CrewAI agents.
# Link to get Key: https://aistudio.google.com/apikey
# Step: Visit the link, sign in with your Google account, click "Create API key", and paste it here.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. MODEL_NAME (OPTIONAL / IKHTIYARI - Default: gemini/gemini-2.5-flash)
# ------------------------------------------------------------------------------
# Urdu: Kaunsa Gemini model use karna hai. Options: gemini/gemini-2.5-flash, gemini/gemini-2.0-flash, gemini/gemini-1.5-flash.
# English: Gemini model to use via LiteLLM provider syntax.
# Default: gemini/gemini-2.5-flash
MODEL_NAME=gemini/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. TAVILY_API_KEY (OPTIONAL / IKHTIYARI)
# ------------------------------------------------------------------------------
# Urdu: Advanced web search API key. Agar yeh na ho toh system free DuckDuckGo search use karega.
# English: Optional Tavily search API key for enhanced web search. Falls back to DuckDuckGo if empty.
# Link to get Key: https://tavily.com (Sign up for free tier)
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 4. API_KEY (REQUIRED FOR FASTAPI & N8N SECURITY / LAZMI)
# ------------------------------------------------------------------------------
# Urdu: FastAPI endpoints ko secure rakhne ke liye secret password. n8n yeh key header mein bhejega.
# English: Secret key to protect the FastAPI /research endpoint from unauthorized requests.
# Set any secret password you prefer (e.g. a long random string).
API_KEY=your_secret_api_key_here

# ------------------------------------------------------------------------------
# 5. N8N_DELIVERY_WEBHOOK_URL (OPTIONAL / IKHTIYARI)
# ------------------------------------------------------------------------------
# Urdu: jab report tayar ho jaye tou n8n ko bhejney ke liye Webhook URL.
# English: Webhook URL triggered when a report is completed to deliver it via Email/Docs in n8n.
# Step: Copy the Webhook URL from your n8n "Report Delivery" workflow node.
N8N_DELIVERY_WEBHOOK_URL=http://localhost:5678/webhook/report-delivery

# ------------------------------------------------------------------------------
# 6. PORT & HOST CONFIGURATION (OPTIONAL / IKHTIYARI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
